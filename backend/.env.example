# Database connection (MySQL)
# Example format: mysql://root:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
DATABASE_URL="mysql://root:password@localhost:3306/sterling_connect"

# Application
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT Security
JWT_ACCESS_SECRET="sterling_connect_jwt_access_secret_super_secure_key_change_in_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="sterling_connect_jwt_refresh_secret_super_secure_key_change_in_prod"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="sterling_connect_cookie_secret_key"

# Protected Upload Storage
UPLOAD_DESTINATION="./src/uploads"
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# Google Workspace Transactional Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="notifications@sterlinglrs.com"
SMTP_APP_PASSWORD="your-16-char-google-workspace-app-password"
SMTP_FROM_NAME="Sterling Connect"
SMTP_FROM_EMAIL="notifications@sterlinglrs.com"

# Sterling Academy Integration
STERLING_ACADEMY_BASE_URL="https://learn.sterlinglrs.com"
